{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '7 days',
  rebaseWhen: 'behind-base-branch',
  hostRules: [
    {
      // dhi.io rejects anonymous requests, so lookups fail without credentials.
      matchHost: 'dhi.io',
      username: 'siutsin',
      password: '{{ secrets.DOCKERHUB_TOKEN }}',
    },
  ],
  packageRules: [
    {
      // The Alloy chart builds its version label from the tag, so the tag
      // must stay bare; the digest lives in the chart's own digest field.
      matchManagers: ['helm-values'],
      matchPackageNames: [
        'grafana/alloy',
      ],
      pinDigests: false,
    },
    {
      // Renovate's default conda registry URL has no channel and 404s.
      matchDatasources: ['conda'],
      registryUrls: ['https://api.anaconda.org/package/conda-forge/'],
    },
    {
      matchDepNames: [
        'ghcr.io/home-assistant/home-assistant'
      ],
      major: {
        automerge: true,
      }
    },
    {
      // Floating `main` tag: upstream deletes superseded digests within days, so a
      // 7 day delay leaves the pin stale and the pull fails with NotFound.
      matchPackageNames: [
        'ghcr.io/teslamate-org/teslamate',
        'ghcr.io/teslamate-org/teslamate/grafana',
      ],
      matchUpdateTypes: ['digest'],
      minimumReleaseAge: null,
    },
  ],
}
