{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '3 days',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: { enabled: true },
  rebaseWhen: 'behind-base-branch',
  // Defaults are 2 PRs per hour and 10 open at once, which is too slow for a
  // burst of updates. Keep a concurrent cap: with rebaseWhen above, every merge
  // rebases all other open PRs and re-runs their CI.
  prHourlyLimit: 10,
  prConcurrentLimit: 15,
  logLevelRemap: [
    {
      matchMessage: "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      newLogLevel: 'info',
    },
  ],
  hostRules: [
    {
      // dhi.io rejects anonymous requests, so lookups fail without credentials.
      matchHost: 'dhi.io',
      username: 'siutsin',
      password: '{{ secrets.DOCKERHUB_TOKEN }}',
    },
  ],
  packageRules: [
    {
      // Image updates keep the 1 day wait. Routine updates wait 3 days.
      matchManagers: ['dockerfile', 'helm-values', 'helmv3'],
      minimumReleaseAge: '1 day',
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      // The Alloy chart builds its version label from the tag, so the tag
      // must stay bare; the digest lives in the chart's own digest field.
      matchManagers: ['helm-values'],
      matchPackageNames: [
        'grafana/alloy',
      ],
      pinDigests: false,
    },
    {
      // Renovate's default conda registry URL has no channel and 404s.
      matchDatasources: ['conda'],
      registryUrls: ['https://api.anaconda.org/package/conda-forge/'],
    },
    {
      matchDepNames: [
        'ghcr.io/home-assistant/home-assistant'
      ],
      major: {
        automerge: true,
      }
    },
    {
      // Floating `main` tag: upstream deletes superseded digests within days, so a
      // 7 day delay leaves the pin stale and the pull fails with NotFound.
      matchPackageNames: [
        'ghcr.io/teslamate-org/teslamate',
        'ghcr.io/teslamate-org/teslamate/grafana',
      ],
      matchUpdateTypes: ['digest'],
      minimumReleaseAge: null,
    },
    {
      // Vulnerability fixes ship at once. The age wait stays for all other updates.
      matchJsonata: [
        '$exists(vulnerabilityFixVersion) or $exists(isVulnerabilityAlert)',
      ],
      minimumReleaseAge: null,
    },
    {
      // diagrams ships no releases (latest 0.25.1, Nov 2025) but is actively
      // developed, so the 1-year abandonment flag is a false positive.
      matchPackageNames: ['diagrams'],
      abandonmentThreshold: null,
    },
  ],
}
