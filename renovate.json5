{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '7 days',
  rebaseWhen: 'behind-base-branch',
  packageRules: [
    {
      matchDepNames: [
        'ghcr.io/home-assistant/home-assistant'
      ],
      major: {
        automerge: true,
      }
    },
    {
      matchPackageNames: [
        'helm/chart-releaser-action',
      ],
      abandonmentThreshold: null,
    },
    {
      // Floating `main` tag: upstream deletes superseded digests within days, so a
      // 7 day delay leaves the pin stale and the pull fails with NotFound.
      matchPackageNames: [
        'ghcr.io/teslamate-org/teslamate',
        'ghcr.io/teslamate-org/teslamate/grafana',
      ],
      matchUpdateTypes: ['digest'],
      minimumReleaseAge: null,
    },
  ],
}
